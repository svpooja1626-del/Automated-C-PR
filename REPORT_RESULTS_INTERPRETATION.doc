<body>

    <div class="header-container">
        <h1 class="title">Engineering Report: Results Interpretation</h1>
        <div class="subtitle">Empirical Validation, Diagnostic Scenarios, and Precision Analysis</div>
    </div>

    <table class="meta-table">
        <tr>
            <td class="label">Document ID</td>
            <td>REP-RES-01</td>
            <td class="label">System Focus</td>
            <td>Rule Verification & Diagnostic Metrics</td>
        </tr>
        <tr>
            <td class="label">Target Platform</td>
